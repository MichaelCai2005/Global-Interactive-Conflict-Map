DATABASE_URL=postgresql+psycopg://conflict:conflict@localhost:5432/conflict
# Cross-source duplicate matching: events within this distance and day window are linked.
LINK_RADIUS_KM=25
LINK_DAY_WINDOW=1
# ACLED account login for `python -m app.ingest download acled`.
ACLED_EMAIL=
ACLED_PASSWORD=

# Link boards (app.boards). "auto" reads articles with Claude when Anthropic credentials are
# set (ANTHROPIC_API_KEY, or an `ant auth login` profile) and with the gazetteer otherwise.
# Claude needs `pip install -e ".[ai]"`.
BOARD_EXTRACTOR=auto
BOARD_CLAUDE_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# OpenStreetMap search for places Claude finds that the events data has never seen; "none" turns it off.
BOARD_GEOCODER=nominatim
# Ground heights for globe exports (Open-Meteo); "none" uses a fixed 400 m.
BOARD_ELEVATION=open-meteo
# Origins allowed to read the API from a browser (the gods-eye-view globe).
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# NASA FIRMS map key for `python -m app.live firms` (free at firms.modaps.eosdis.nasa.gov/api/map_key).
FIRMS_MAP_KEY=

# Hosting (see docs/hosting.md). With ADMIN_TOKEN set, requests that change data must send
# `Authorization: Bearer <token>`. PUBLIC_MODE=true makes the API read-only without the
# token and refuses to start on a database that holds ACLED events.
# ADMIN_TOKEN=
PUBLIC_MODE=false

# Accounts (app/auth.py). People sign up with an email and password and keep their own
# watchlist, tasks, boards and saved searches. A sign-in lasts SESSION_DAYS. Cookies are
# HTTPS-only when PUBLIC_MODE is on, unless SECURE_COOKIES says otherwise.
# SIGNUPS_OPEN=false stops new accounts; existing ones still sign in.
SESSION_DAYS=30
# SECURE_COOKIES=
SIGNUPS_OPEN=true
# The built frontend for `uvicorn app.site:app`, which serves it beside the API at /api.
# STATIC_DIR=../frontend/dist
